{
  "_meta": {
    "version": "v2",
    "source": "Everstory_mixed.jsx + templates/template_cutout_v2.ait",
    "extracted": "2026-06-12",
    "note": "시트 packing implementation 토큰 (사이즈·trace 파라미터·CutContour spot·save·rasterize). SOT 는 운영 .jsx — 본 파일은 doc mirror, .jsx 상수 변경 시 같이 갱신."
  },

  "conversion": {
    "mm_to_pt": 2.834645
  },

  "layout": {
    "_note": "Sheet packing baseline. 운영 .jsx 가 .ait 와 expanded 값을 직접 사용 — 본 키는 doc reference.",
    "body_padding_mm": 2,
    "gap_mm": 2.5,
    "max_sheet_cap": 1,
    "tier_pack_efficiency": 0.8
  },

  "sizes_mm": {
    "_note": "단일 사이즈 6단계, 긴 변 기준. 기본값 = 1in (다이어리 표준).",
    "options": [19.05, 25.4, 31.75, 38.1, 50.8, 63.5],
    "labels": ["0.75in", "1in", "1.25in", "1.5in", "2in", "2.5in"],
    "default": 25.4
  },

  "slots_by_size": {
    "_note": "body 142x175mm + padding 2 + gap 2.5, 정사각(aspect 1) 셀 기준 cols x rows. 단일 사이즈 listbox cap = 이 값 (정사각이 최소 슬롯 케이스 → cap <= 실제 슬롯 보장). body/padding/gap 변경 시 재산출.",
    "19.05": 48,
    "25.4": 30,
    "31.75": 20,
    "38.1": 12,
    "50.8": 6,
    "63.5": 4
  },

  "cut_margins_mm": {
    "_note": "내부 제작 옵션 (고객 옵션 아님). 기본 0mm.",
    "options": [0, 0.5, 1, 2],
    "default": 0
  },

  "trace": {
    "preset": "Silhouettes",
    "tracing_mode": "BLACKANDWHITE",
    "tracing_method": "ABUTTING",
    "threshold": 230,
    "path_fidelity": 10,
    "corner_fidelity": 10,
    "minimum_area": 250,
    "corner_angle": 20,
    "fills": true,
    "strokes": false,
    "snap_curve_to_lines": false,
    "ignore_white": true
  },

  "trace_doc": {
    "width": 1000,
    "height": 1000,
    "color_mode": "RGB",
    "units": "mm"
  },

  "cut_contour_spot": {
    "name": "CutContour",
    "color_type": "SPOT",
    "cmyk": { "c": 0, "m": 100, "y": 0, "k": 0 },
    "tint": 100,
    "stroke_width_pt": 0.25
  },

  "save_ai": {
    "compatibility": "ILLUSTRATOR24",
    "pdf_compatible": true,
    "embed_icc_profile": true
  },

  "output_naming": "{ts}_{sizeTag}_sheet01.ai",
  "output_naming_note": "sizeTag = 인치 표기(예: 1in) | PKG | ALL. 한 시트 정책으로 sheet01 고정 — Full Package 는 동일 시트 2회 인쇄.",

  "rasterize": {
    "color_model": "DEFAULTCOLORMODEL",
    "resolution_dpi": 300
  }
}
