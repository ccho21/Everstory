{
  "_meta": {
    "version": "v1",
    "source": "Everstory_mixed.jsx + templates/template_cutout_v2.ait",
    "extracted": "2026-05-08",
    "note": "시트 packing implementation 토큰 (사이즈·trace 파라미터·CutContour spot·save·rasterize). 운영 .jsx 가 본 파일의 expanded 값을 직접 참조. web 디자인 토큰은 docs/design/tokens.json."
  },

  "conversion": {
    "mm_to_pt": 2.834645
  },

  "layout": {
    "_note": "Sheet packing baseline. 운영 .jsx 가 .ait 와 packing_internals.md 의 expanded 값을 직접 사용 — 본 키는 doc reference.",
    "body_padding_mm": 2,
    "gap_mm": 2,
    "max_sheet_cap": 1,
    "repeat_threshold_ratio": 0.6
  },

  "sizes_mm": {
    "options": [20, 30, 60],
    "labels": ["2cm", "3cm", "6cm"],
    "default": 60
  },

  "cut_margins_mm": {
    "options": [1, 2],
    "default": 1
  },

  "trace": {
    "preset": "Silhouettes",
    "tracing_mode": "BLACKANDWHITE",
    "tracing_method": "ABUTTING",
    "threshold": 230,
    "path_fidelity": 10,
    "corner_fidelity": 10,
    "minimum_area": 250,
    "corner_angle": 20,
    "fills": true,
    "strokes": false,
    "snap_curve_to_lines": false,
    "ignore_white": true
  },

  "trace_doc": {
    "width": 1000,
    "height": 1000,
    "color_mode": "RGB",
    "units": "mm"
  },

  "cut_contour_spot": {
    "name": "CutContour",
    "color_type": "SPOT",
    "cmyk": { "c": 0, "m": 100, "y": 0, "k": 0 },
    "tint": 100,
    "stroke_width_pt": 0.25
  },

  "save_ai": {
    "compatibility": "ILLUSTRATOR24",
    "pdf_compatible": true,
    "embed_icc_profile": true
  },

  "output_naming": "{ts}_{sizeMm}mm_sheet{NN:02d}.ai",

  "rasterize": {
    "color_model": "DEFAULTCOLORMODEL",
    "resolution_dpi": 300
  }
}
