{
  "version": "1.0.0",
  "thresholds": {
    "approve_candidate_min": 90,
    "single_variable_revision_min": 80,
    "reject_below": 80
  },
  "hard_fails": [
    "identity changed",
    "face redrawn or blended",
    "full-body pose, clothing, hands, or feet changed",
    "shape artwork outline changed",
    "verified sheet layout or sticker count changed",
    "sticker removed from a pristine sheet",
    "fake or corrupted brand text presented as final",
    "QR or logo altered in a final product image",
    "sticker scale physically implausible",
    "sticker rendered as a thick badge",
    "supplied device logo covered or changed",
    "unreferenced device invented for S03"
  ],
  "score": {
    "product_fidelity": {
      "points": 40,
      "checks": ["identity", "artwork", "cutline", "sheet layout", "text and QR"]
    },
    "physical_accuracy": {
      "points": 20,
      "checks": ["true size", "thin vinyl", "surface adhesion", "contact shadow"]
    },
    "composition": {
      "points": 15,
      "checks": ["alignment", "equal spacing", "clear hierarchy", "no filler props"]
    },
    "color_and_light": {
      "points": 15,
      "checks": ["scene recipe", "neutral white balance", "no yellow cast", "material separation"]
    },
    "scene_purpose": {
      "points": 10,
      "checks": ["customer question answered", "appropriate surface", "background supports product"]
    }
  },
  "review_output": {
    "required_fields": ["score", "hard_fails", "pass_or_action", "single_next_change"]
  }
}

