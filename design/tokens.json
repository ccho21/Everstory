{
  "_meta": {
    "version": "v5",
    "source": "docs/design/brand.md.",
    "extracted": "2026-05-08",
    "note": "Web 디자인 토큰. 시트 packing 토큰은 docs/implementation/sheet_tokens.json 으로 분리. colors.print (5색 lock, 시트) vs colors.web (CTA/state/border 추가, Shopify). typography.print (.ait 보유 size·tracking) vs typography.web (Adobe Fonts + scale). web_layout (spacing/breakpoints/container)."
  },

  "colors": {
    "_note": "Print 5색 lock, Web 확장. Print 시트 안에서는 추가 컬러 도입 금지. Web UI 는 derived neutral + state 추가 허용.",
    "print": {
      "text": {
        "primary": { "hex": "#000000", "rgb": [0, 0, 0], "usage": "워드마크·tagline·info·chip 라벨·QR caption" }
      },
      "bg": {
        "matte_white": { "hex": "#FEFDFE", "rgb": [254, 253, 254], "usage": "일반 시트 배경 (White matte)" },
        "pearl_grey": { "hex": "#E0D3CB", "rgb": [224, 211, 203], "usage": "방수 시트 배경 (Pearl Grey, warm beige)" }
      },
      "sticker": {
        "padding": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "usage": "사진 외곽 cut margin 흰색 stroke" }
      },
      "accent": {
        "coral": { "hex": "#FBAAA8", "rgb": [251, 170, 168], "usage": "시트 footer chip 1 ♡ (감사·온기). 시트 안 유일 강조색." }
      }
    },
    "web": {
      "_note": "Print 5색 (#000 / #FEFDFE / #E0D3CB / #FFF / #FBAAA8) 보존하면서 web UI 에 필수인 derived neutrals + state colors 추가. CTA = black 버튼 + coral 텍스트 액센트.",
      "text": {
        "primary":   { "hex": "#000000", "usage": "본문 헤딩, primary CTA 라벨" },
        "secondary": { "hex": "#4A4A4A", "usage": "본문 paragraph, longer copy" },
        "muted":     { "hex": "#8A8580", "usage": "captions, meta (날짜, 라벨)" },
        "inverse":   { "hex": "#FFFFFF", "usage": "dark bg 위 텍스트" },
        "accent_coral": { "hex": "#FBAAA8", "usage": "텍스트 액센트 (link hover underline, eyebrow). 배경으로 쓰지 않음." }
      },
      "bg": {
        "canvas":     { "hex": "#FEFDFE", "usage": "기본 페이지 배경 (matte_white 그대로)" },
        "muted":      { "hex": "#F8F5F2", "usage": "section alt 배경, card surface" },
        "warm":       { "hex": "#E0D3CB", "usage": "accent block (pearl_grey, About / story 영역)" },
        "inverse":    { "hex": "#000000", "usage": "dark section, footer" }
      },
      "border": {
        "subtle":  { "hex": "#ECE6E0", "usage": "input border, card outline" },
        "strong":  { "hex": "#1A1A1A", "usage": "강조 박스, dark mode divider" },
        "focus":   { "hex": "#000000", "usage": "focus ring (a11y)" }
      },
      "button": {
        "primary": {
          "bg":            { "hex": "#000000" },
          "fg":            { "hex": "#FFFFFF" },
          "hover_bg":      { "hex": "#1A1A1A" },
          "hover_underline": { "hex": "#FBAAA8", "usage": "hover 시 라벨 아래 1px coral underline" }
        },
        "secondary": {
          "bg":       { "hex": "transparent" },
          "fg":       { "hex": "#000000" },
          "border":   { "hex": "#000000" },
          "hover_bg": { "hex": "#F8F5F2" }
        },
        "ghost": {
          "bg":       { "hex": "transparent" },
          "fg":       { "hex": "#000000" },
          "hover_underline": { "hex": "#FBAAA8" }
        }
      },
      "state": {
        "error":   { "hex": "#B23A3A", "usage": "form 에러 메시지, 결제 실패" },
        "success": { "hex": "#2E7D5B", "usage": "주문 완료, 업로드 성공" },
        "warning": { "hex": "#C77A2E", "usage": "재고 경고, mockup 대기 안내" }
      }
    }
  },

  "typography": {
    "_note": "Print 슬롯 (.ait 보유 size·tracking) 과 Web 스케일 (Adobe Fonts) 분리. 폰트 family 3종 lock — Web 도 동일 3종 운영, fallback stack 만 web 고유.",
    "families": {
      "display_wordmark": "Amandine Bold",
      "display_subscript": "Titular Bold",
      "body": "Avenir Next LT Pro Bold"
    },
    "print": {
      "_note": "정확한 size·tracking 은 .ait 보유. 본 표는 추정값.",
      "slots": {
        "display.wordmark":  { "family": "Amandine Bold",          "size_pt_estimate": 40,  "tracking": 0,   "case": "upper" },
        "display.subscript": { "family": "Titular Bold",           "size_pt_estimate": 8,   "tracking": 200, "case": "upper" },
        "display.tagline":   { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 5.5, "tracking": 100, "case": "upper" },
        "info.line1":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 8.5, "tracking": 0,   "case": "mixed" },
        "info.line2":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 8.5, "tracking": 0,   "case": "mixed" },
        "chip.label":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 7.5, "tracking": 50,  "case": "upper" },
        "chip.subline":      { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 6.5, "tracking": 0,   "case": "mixed" },
        "qr.caption":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 5.5, "tracking": 50,  "case": "upper" }
      }
    },
    "web": {
      "_note": "Adobe Fonts (Avenir Next LT Pro) + SVG 워드마크 + 무료 세리프로 editorial display 매칭. 영어 단일 정책 (Hangul fallback 미설정).",
      "stacks": {
        "display": "'Cormorant Garamond', 'Playfair Display', Georgia, serif",
        "body":    "'Avenir Next LT Pro', 'Avenir Next', 'Helvetica Neue', system-ui, sans-serif",
        "wordmark_svg": "assets/wordmark.svg (font 의존성 회피)"
      },
      "scale_rem": {
        "_note": "1rem = 16px. mobile-first (이 값이 mobile), desktop 은 components.md 의 hierarchy 규칙으로 +1 step.",
        "xs":   0.75,
        "sm":   0.875,
        "base": 1.0,
        "md":   1.125,
        "lg":   1.25,
        "xl":   1.5,
        "2xl":  2.0,
        "3xl":  3.0,
        "4xl":  4.0
      },
      "line_height": {
        "tight":   1.1,
        "snug":    1.25,
        "normal":  1.5,
        "loose":   1.75
      },
      "tracking_em": {
        "tight":   "-0.02em",
        "normal":  "0",
        "wide":    "0.05em",
        "wider":   "0.1em",
        "widest":  "0.2em"
      },
      "hierarchy_rules": [
        "Bold weight 만 사용 (print 와 동일). Regular/Medium/Light 도입 금지.",
        "Hierarchy 는 size + tracking + case 조합으로만 만든다.",
        "UPPER + tracking wider/widest = eyebrow / label / chip",
        "mixed case + tracking normal = body / paragraph",
        "큰 헤딩 (>2xl) 은 display 스택 (serif). 그 외는 body 스택 (sans)."
      ]
    }
  },

  "web_layout": {
    "_note": "4px base grid, mobile-first.",
    "spacing_px": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "6": 24,
      "8": 32,
      "12": 48,
      "16": 64,
      "24": 96,
      "32": 128
    },
    "container_px": {
      "content": 1280,
      "wide": 1440,
      "narrow": 720
    },
    "breakpoints_px": {
      "mobile_max": 639,
      "tablet_min": 640,
      "tablet_max": 1023,
      "desktop_min": 1024
    },
    "section_padding_px": {
      "mobile_y": 64,
      "desktop_y": 96,
      "desktop_y_hero": 128
    },
    "grid": {
      "desktop_cols": 12,
      "mobile_cols": 4,
      "gap_px_mobile": 16,
      "gap_px_desktop": 24
    },
    "radius_px": {
      "none": 0,
      "sm": 2,
      "md": 4,
      "_note": "보수적 — luxury / editorial 톤이라 큰 radius (8+) 는 사용 안 함. 기본 sharp corner."
    },
    "shadow": {
      "_note": "luxury 톤 보존 — drop shadow 사용 안 함. 깊이는 spacing + bg.muted 로만 표현.",
      "none": "none"
    }
  }
}
