  "typography": {
    "_note": "Print 슬롯 (.ait 보유 size·tracking) 과 Web 스케일 (Adobe Fonts) 분리. 폰트 family 3종 lock (ADR-0004) — Web 도 동일 3종 운영, fallback stack 만 web 고유.",
    "families": {
      "display_wordmark": "Amandine Bold",
      "display_subscript": "Titular Bold",
      "body": "Avenir Next LT Pro Bold"
    },
    "print": {
      "_note": "정확한 size·tracking 은 .ait 보유. 본 표는 추정값.",
      "slots": {
        "display.wordmark":  { "family": "Amandine Bold",          "size_pt_estimate": 40,  "tracking": 0,   "case": "upper" },
        "display.subscript": { "family": "Titular Bold",           "size_pt_estimate": 8,   "tracking": 200, "case": "upper" },
        "display.tagline":   { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 5.5, "tracking": 100, "case": "upper" },
        "info.line1":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 8.5, "tracking": 0,   "case": "mixed" },
        "info.line2":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 8.5, "tracking": 0,   "case": "mixed" },
        "chip.label":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 7.5, "tracking": 50,  "case": "upper" },
        "chip.subline":      { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 6.5, "tracking": 0,   "case": "mixed" },
        "qr.caption":        { "family": "Avenir Next LT Pro Bold", "size_pt_estimate": 5.5, "tracking": 50,  "case": "upper" }
      }
    },
    "web": {
      "_note": "사용자 결정 #1 — Adobe Fonts (Avenir Next LT Pro) + SVG 워드마크 + 무료 세리프로 editorial display 매칭. Hangul 폴백 미설정 (영어 단일, 사용자 결정 #3).",
      "stacks": {
        "display": "'Cormorant Garamond', 'Playfair Display', Georgia, serif",
        "body":    "'Avenir Next LT Pro', 'Avenir Next', 'Helvetica Neue', system-ui, sans-serif",
        "wordmark_svg": "assets:design/wordmark.svg (font 의존성 회피)"
      },
      "fallback_choice_pending": "Cormorant Garamond 600 vs Playfair Display 700 — Phase A 끝에 시안 비교 후 lock. 현재 stacks.display 는 둘 다 시도 후 system serif 폴백.",
      "scale_rem": {
        "_note": "1rem = 16px. mobile-first (이 값이 mobile), desktop 은 components.md 의 hierarchy 규칙으로 +1 step.",
        "xs":   0.75,
        "sm":   0.875,
        "base": 1.0,
        "md":   1.125,
        "lg":   1.25,
        "xl":   1.5,
        "2xl":  2.0,
        "3xl":  3.0,
        "4xl":  4.0
      },
      "line_height": {
        "tight":   1.1,
        "snug":    1.25,
        "normal":  1.5,
        "loose":   1.75
      },
      "tracking_em": {
        "tight":   "-0.02em",
        "normal":  "0",
        "wide":    "0.05em",
        "wider":   "0.1em",
        "widest":  "0.2em"
      },
      "hierarchy_rules": [
        "Bold weight 만 사용 (print 와 동일). Regular/Medium/Light 도입 금지.",
        "Hierarchy 는 size + tracking + case 조합으로만 만든다.",
        "UPPER + tracking wider/widest = eyebrow / label / chip",
        "mixed case + tracking normal = body / paragraph",
        "큰 헤딩 (>2xl) 은 display 스택 (serif). 그 외는 body 스택 (sans)."
      ]
    }
  },

  "web_layout": {
    "_note": "ADR-0006 부속. Phase A.3. 4px base grid, mobile-first.",
    "spacing_px": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "6": 24,
      "8": 32,
      "12": 48,
      "16": 64,
      "24": 96,
      "32": 128
    },
    "container_px": {
      "content": 1280,
      "wide": 1440,
      "narrow": 720
    },
    "breakpoints_px": {
      "mobile_max": 639,
      "tablet_min": 640,
      "tablet_max": 1023,
      "desktop_min": 1024
    },
    "section_padding_px": {
      "mobile_y": 64,
      "desktop_y": 96,
      "desktop_y_hero": 128
    },
    "grid": {
      "desktop_cols": 12,
      "mobile_cols": 4,
      "gap_px_mobile": 16,
      "gap_px_desktop": 24
    },
    "radius_px": {
      "none": 0,
      "sm": 2,
      "md": 4,
      "_note": "보수적 — luxury / editorial 톤이라 큰 radius (8+) 는 사용 안 함. 기본 sharp corner."
    },
    "shadow": {
      "_note": "luxury 톤 보존 — drop shadow 사용 안 함. 깊이는 spacing + bg.muted 로만 표현.",
      "none": "none"
    }
  },

  "conversion": {
    "mm_to_pt": 2.834645
  },

  "layout": {
    "_note": "Sheet packing 토큰 (legacy v10 baseline). 운영 .jsx 가 .ait 와 docs/everstory_mixed_internals.md 의 expanded 값을 직접 사용 — 본 키는 doc reference.",
    "body_padding_mm": 2,
    "gap_mm": 2,
    "max_sheet_cap": 1,
    "repeat_threshold_ratio": 0.6
  },

  "sizes_mm": {
    "options": [20, 30, 60],
    "labels": ["2cm", "3cm", "6cm"],
    "default": 60
  },

  "cut_margins_mm": {
    "options": [1, 2],
    "default": 1
  },

  "trace": {
    "preset": "Silhouettes",
    "tracing_mode": "BLACKANDWHITE",
    "tracing_method": "ABUTTING",
    "threshold": 230,
    "path_fidelity": 10,
    "corner_fidelity": 10,
    "minimum_area": 250,
    "corner_angle": 20,
    "fills": true,
    "strokes": false,
    "snap_curve_to_lines": false,
    "ignore_white": true
  },

  "trace_doc": {
    "width": 1000,
    "height": 1000,
    "color_mode": "RGB",
    "units": "mm"
  },

  "cut_contour_spot": {
    "name": "CutContour",
    "color_type": "SPOT",
    "cmyk": { "c": 0, "m": 100, "y": 0, "k": 0 },
    "tint": 100,
    "stroke_width_pt": 0.25
  },

  "save_ai": {
    "compatibility": "ILLUSTRATOR24",
    "pdf_compatible": true,
    "embed_icc_profile": true
  },

  "output_naming": "{ts}_{sizeMm}mm_sheet{NN:02d}.ai",

  "rasterize": {
    "color_model": "DEFAULTCOLORMODEL",
    "resolution_dpi": 300
  }
}
