          "hover_underline": { "hex": "#FBAAA8" }
        }
      },
      "state": {
        "error":   { "hex": "#B23A3A", "usage": "form 에러 메시지, 결제 실패" },
        "success": { "hex": "#2E7D5B", "usage": "주문 완료, 업로드 성공" },
        "warning": { "hex": "#C77A2E", "usage": "재고 경고, mockup 대기 안내" }
