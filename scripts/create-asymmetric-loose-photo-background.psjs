
const { app, core, action, constants } = require("photoshop");
const { script } = require("uxp");

// ─────────────────────────────────────────────────────────────
// 사용자 설정값 (SUBJECT 짧은 변에 대한 비율)
// ─────────────────────────────────────────────────────────────
const CONFIG = Object.freeze({
  topMarginRatio: 0.06,
  bottomMarginRatio: 0.16,
  closeRadiusRatio: 0.03,
  smoothRadiusRatio: 0.03,
  finalSmoothRadiusRatio: 0.05,
  pathTolerance: 4.0,
  sideProfile: Object.freeze([
    Object.freeze({ name: "Head", from: 0.00, to: 0.30, marginRatio: 0.03 }),
    Object.freeze({ name: "Face / Shoulders", from: 0.27, to: 0.58, marginRatio: 0.16 }),
    Object.freeze({ name: "Upper Body", from: 0.48, to: 0.72, marginRatio: 0.075 }),
    Object.freeze({ name: "Body", from: 0.65, to: 1.00, marginRatio: 0.045 })
  ]),
  handProfile: Object.freeze({
    from: 0.34,
    to: 0.90,
    outerWidthRatio: 0.32,
    marginRatio: 0.08
  }),
  defaultColor: { red: 219, green: 139, blue: 122 },
  showColorPicker: true,
  autoResizeCanvas: true
});

const SUBJECT_LAYER_NAME = "Layer 0";
const LOOSE_LAYER_NAME = "Ellipse 1";
const ORIGINAL_LAYER_NAME = "ORIGINAL";
const LEGACY_LOOSE_LAYER_NAME = "LOOSE BACKGROUND";
const HISTORY_NAME = "Create Asymmetric Loose Photo Background";

async function main() {
  try {
    validateConfig(CONFIG);

    if (app.documents.length === 0) {
      throw new Error("No Photoshop document is currently open.");
    }

    const doc = app.activeDocument;
    if (!doc.activeLayers || doc.activeLayers.length !== 1) {
      throw new Error("Please select the SUBJECT layer first.");
    }

    const subject = doc.activeLayers[0];
    if (subject.kind === constants.LayerKind.GROUP) {
      throw new Error("Please select the SUBJECT layer itself, not a layer group.");
    }

    ensureNoExistingResult(doc, subject);
    let resultSummary = null;

    // .psjs는 Photoshop이 제공한 Script Execution Context 안에서 이미 실행된다.
    // 플러그인용 executeAsModal을 중첩하지 않고 script.hostControl을 직접 사용한다.
    const executionContext = script.executionContext;
    const suspension = await executionContext.hostControl.suspendHistory({
      documentID: doc.id,
      name: HISTORY_NAME
    });

    try {
      resultSummary = await createAsymmetricLooseBackground(doc, subject, CONFIG);
      await executionContext.hostControl.resumeHistory(suspension, true);
    } catch (error) {
      try {
        await executionContext.hostControl.resumeHistory(suspension, false);
      } catch (rollbackError) {
        console.error("History rollback failed", rollbackError);
      }
      throw error;
    }

    await core.showAlert({
      message:
        "Editable color loose background created.\n\n" +
        "Ready: F3 merge -> F1 silhouette\n" +
        "Layers: Layer 0 + Ellipse 1\n\n" +
        `${formatCanvasResize(resultSummary && resultSummary.canvasResize)}\n` +
        `Top ${Math.round(CONFIG.topMarginRatio * 100)}% / ` +
        `Bottom ${Math.round(CONFIG.bottomMarginRatio * 100)}%\n` +
        "Head 3% / Hands 8% / Face-Shoulders 16% / Body 5%"
    });
  } catch (error) {
    console.error(error);
    await core.showAlert({ message: error.message || String(error) });
  }
}

async function createAsymmetricLooseBackground(doc, subject, config) {
  await runStage("Load SUBJECT shape", () => loadSubjectShapeSelection(doc, subject));
  assertSelection(
    doc,
    "The selected SUBJECT layer appears to be empty or fully transparent."
  );

  const initialBounds = copyBounds(doc.selection.bounds);
  const subjectBasisPx = Math.min(
    initialBounds.right - initialBounds.left,
    initialBounds.bottom - initialBounds.top
  );
  const closePx = ratioToPixels(config.closeRadiusRatio, subjectBasisPx);
  const smoothPx = ratioToPixels(config.smoothRadiusRatio, subjectBasisPx);
  const finalSmoothPx = ratioToPixels(config.finalSmoothRadiusRatio, subjectBasisPx);
  const topPx = ratioToPixels(config.topMarginRatio, subjectBasisPx);
  const bottomPx = ratioToPixels(config.bottomMarginRatio, subjectBasisPx);
  const maxSideMarginRatio = Math.max(
    ...config.sideProfile.map((band) => band.marginRatio),
    config.handProfile ? config.handProfile.marginRatio : 0
  );
  const maxSideMarginPx = ratioToPixels(maxSideMarginRatio, subjectBasisPx);
  const canvasResize = config.autoResizeCanvas
    ? await ensureCanvasFitsLooseBackground(doc, initialBounds, {
      left: Math.max(closePx, smoothPx, maxSideMarginPx + finalSmoothPx),
      right: Math.max(closePx, smoothPx, maxSideMarginPx + finalSmoothPx),
      top: Math.max(closePx, smoothPx, maxSideMarginPx, topPx + finalSmoothPx),
      bottom: Math.max(closePx, smoothPx, maxSideMarginPx, bottomPx + finalSmoothPx)
    })
    : createUnchangedCanvasResize(doc);

  if (canvasResize.resized) {
    await runStage("Reload SUBJECT after canvas resize", () => loadSubjectShapeSelection(doc, subject));
    assertSelection(doc, "The SUBJECT mask could not be reloaded after resizing the canvas.");
  }

  // Morphological closing: 좁은 홈과 손가락/머리카락 사이의 작은 틈을 메운다.
  if (closePx > 0) {
    await expandSelectionBy(doc, closePx);
    await contractSelectionBy(doc, closePx);
    assertSelection(doc, "The SUBJECT selection disappeared during gap closing.");
  }

  if (smoothPx > 0) {
    await doc.selection.smooth(Math.min(500, smoothPx), true);
    assertSelection(doc, "The SUBJECT selection disappeared during smoothing.");
  }

  // Work Path tolerance로 미세한 굴곡과 과도한 anchor를 한 번 더 단순화한다.
  await runStage(
    "Simplify selection through Work Path",
    () => simplifySelectionThroughWorkPath(doc, config.pathTolerance)
  );
  const simplifiedBounds = copyBounds(doc.selection.bounds);

  // 높이별로 서로 다른 좌우 여백을 적용한다. 겹치는 band를 합쳐 머리는 짧게,
  // 얼굴/어깨는 넓게, 몸통은 다시 타이트해지는 유기적인 외곽을 만든다.
  await runStage(
    "Build profiled side margins",
    () => buildProfiledSideSelection(
      doc,
      simplifiedBounds,
      subjectBasisPx,
      config.sideProfile,
      config.handProfile
    )
  );

  // 현재 selection을 세로로 선형 재매핑한다.
  // 위쪽은 topMarginRatio, 아래쪽은 bottomMarginRatio에 맞고 중간 지점은 두 값 사이에서
  // 점진적으로 변화하므로 계단식이 아닌 자연스러운 비대칭 여백이 된다.
  await runStage(
    "Remap selection vertically",
    () => remapSelectionVertically(
      doc,
      simplifiedBounds.top - topPx,
      simplifiedBounds.bottom + bottomPx
    )
  );

  // band 합성부와 큰 굴곡을 한 번 더 평활화한다. 마지막 Work Path 변환은
  // 남은 미세 계단과 과도한 anchor를 정리해 커팅 라인을 매끄럽게 유지한다.
  if (finalSmoothPx > 0) {
    await doc.selection.smooth(Math.min(500, finalSmoothPx), true);
    assertSelection(doc, "The final loose selection disappeared during smoothing.");
  }

  await runStage(
    "Polish final loose outline",
    () => simplifySelectionThroughWorkPath(doc, config.pathTolerance)
  );

  assertSelection(doc, "The final asymmetric loose selection is empty.");

  // CircleBeforeColor와 같은 editable Solid Color Fill Layer를 만든다.
  // 활성 selection은 생성되는 Fill Layer의 layer mask가 된다.
  const looseLayer = await runStage(
    "Create editable color background",
    () => createSolidColorFillFromSelection(doc, config)
  );

  // Photoshop 레이어 스택에서 PLACEAFTER는 기준 레이어 바로 아래다.
  looseLayer.move(subject, constants.ElementPlacement.PLACEAFTER);
  subject.name = SUBJECT_LAYER_NAME;
  deleteLayersByName(doc.layers, ORIGINAL_LAYER_NAME, new Set([subject.id, looseLayer.id]));

  await doc.selection.deselect();
  await selectLayerById(looseLayer.id);
  return { canvasResize };
}

async function simplifySelectionThroughWorkPath(doc, tolerance) {
  const existingWorkPath = Array.from(doc.pathItems).find(
    (path) => path.kind === constants.PathKind.WORKPATH
  );

  if (existingWorkPath) {
    throw new Error(
      "An unsaved Work Path already exists. Save or rename it before running this script."
    );
  }

  const workPath = await doc.selection.makeWorkPath(tolerance);
  try {
    await workPath.makeSelection(0, true, constants.SelectionType.REPLACE);
  } finally {
    await workPath.remove();
  }

  assertSelection(doc, "The selection disappeared while simplifying the Work Path.");
}

async function buildProfiledSideSelection(doc, subjectBounds, basisPx, profile, handProfile) {
  const token = `${Date.now()}_${Math.round(Math.random() * 100000)}`;
  const baseName = `__EVERSTORY_BASE_${token}`;
  const resultName = `__EVERSTORY_PROFILE_${token}`;
  let baseChannel = null;
  let resultChannel = null;

  try {
    await doc.selection.save(baseName);
    baseChannel = doc.channels.getByName(baseName);

    const subjectHeight = subjectBounds.bottom - subjectBounds.top;
    const horizontalPadding = Math.max(basisPx, subjectBounds.right - subjectBounds.left);

    for (const band of profile) {
      await doc.selection.load(baseChannel, constants.SelectionType.REPLACE, false);

      const bandTop = subjectBounds.top + subjectHeight * band.from;
      const bandBottom = subjectBounds.top + subjectHeight * band.to;
      await doc.selection.selectRectangle(
        {
          top: bandTop,
          left: subjectBounds.left - horizontalPadding,
          bottom: bandBottom,
          right: subjectBounds.right + horizontalPadding
        },
        constants.SelectionType.INTERSECT,
        0,
        false
      );

      if (!doc.selection.bounds) continue;

      const marginPx = ratioToPixels(band.marginRatio, basisPx);
      if (marginPx > 0) await expandSelectionBy(doc, marginPx);

      if (!resultChannel) {
        await doc.selection.save(resultName);
        resultChannel = doc.channels.getByName(resultName);
      } else {
        await doc.selection.saveTo(resultChannel, constants.SelectionType.EXTEND);
      }
    }

    // Preserve a tight torso while adding a separate loose margin around lateral
    // arm/hand protrusions in the middle and lower part of the silhouette.
    if (handProfile) {
      const subjectWidth = subjectBounds.right - subjectBounds.left;
      const handTop = subjectBounds.top + subjectHeight * handProfile.from;
      const handBottom = subjectBounds.top + subjectHeight * handProfile.to;
      const outerWidth = subjectWidth * handProfile.outerWidthRatio;
      const handRects = [
        {
          top: handTop,
          left: subjectBounds.left - horizontalPadding,
          bottom: handBottom,
          right: subjectBounds.left + outerWidth
        },
        {
          top: handTop,
          left: subjectBounds.right - outerWidth,
          bottom: handBottom,
          right: subjectBounds.right + horizontalPadding
        }
      ];

      for (const rect of handRects) {
        await doc.selection.load(baseChannel, constants.SelectionType.REPLACE, false);
        await doc.selection.selectRectangle(rect, constants.SelectionType.INTERSECT, 0, false);
        if (!doc.selection.bounds) continue;

        await expandSelectionBy(doc, ratioToPixels(handProfile.marginRatio, basisPx));
        if (!resultChannel) {
          await doc.selection.save(resultName);
          resultChannel = doc.channels.getByName(resultName);
        } else {
          await doc.selection.saveTo(resultChannel, constants.SelectionType.EXTEND);
        }
      }
    }

    if (!resultChannel) {
      throw new Error("The SUBJECT did not intersect any side-profile band.");
    }

    await doc.selection.load(resultChannel, constants.SelectionType.REPLACE, false);
    assertSelection(doc, "The profiled loose selection is empty.");
  } finally {
    if (resultChannel) await resultChannel.remove();
    if (baseChannel) await baseChannel.remove();
  }
}

async function remapSelectionVertically(doc, desiredTop, desiredBottom) {
  const before = copyBounds(doc.selection.bounds);
  const currentHeight = before.bottom - before.top;
  const desiredHeight = desiredBottom - desiredTop;

  if (!(currentHeight > 0) || !(desiredHeight > 0)) {
    throw new Error("The SUBJECT bounds are too small to build an asymmetric silhouette.");
  }

  const verticalScalePercent = (desiredHeight / currentHeight) * 100;
  await doc.selection.resizeBoundary(
    100,
    verticalScalePercent,
    constants.AnchorPosition.MIDDLECENTER,
    constants.InterpolationMethod.BICUBIC
  );

  assertSelection(doc, "The selection disappeared during vertical remapping.");

  const scaled = copyBounds(doc.selection.bounds);
  await doc.selection.translateBoundary(0, desiredTop - scaled.top);
}

async function loadSubjectShapeSelection(doc, subject) {
  // selection.load(layer)는 layer mask가 아닌 레이어 자체의 픽셀 투명도를 읽는다.
  // 수동 누끼가 layer mask 기반이면 mask channel을 직접 selection으로 로드한다.
  if (await layerHasUserMask(subject.id)) {
    await selectLayerById(subject.id);
    const result = await action.batchPlay([{
      _obj: "set",
      _target: [{ _ref: "channel", _property: "selection" }],
      to: { _ref: "channel", _enum: "channel", _value: "mask" },
      _options: { dialogOptions: "dontDisplay" }
    }], {});
    throwOnBatchPlayError(result, "Could not load the SUBJECT layer mask.");
    return;
  }

  await doc.selection.load(subject, constants.SelectionType.REPLACE, false);
}

async function createSolidColorFillFromSelection(doc, config) {
  const color = config.defaultColor;
  const result = await action.batchPlay([{
    _obj: "make",
    _target: [{ _ref: "contentLayer" }],
    using: {
      _obj: "contentLayer",
      type: {
        _obj: "solidColorLayer",
        color: {
          _obj: "RGBColor",
          red: color.red,
          grain: color.green,
          blue: color.blue
        }
      }
    },
    _options: { dialogOptions: "dontDisplay" }
  }], {});

  throwOnBatchPlayError(result, "Could not create the Solid Color Fill Layer.");

  const fillLayer = doc.activeLayers && doc.activeLayers[0];
  if (!fillLayer) {
    throw new Error("Photoshop did not return the new Solid Color Fill Layer.");
  }

  fillLayer.name = LOOSE_LAYER_NAME;
  fillLayer.visible = true;

  // Photoshop은 selection이 활성화된 상태에서 Fill Layer를 만들면 보통 자동으로
  // selection mask를 붙인다. 호스트 설정상 그렇지 않은 경우에도 동일 결과를 보장한다.
  if (!(await layerHasUserMask(fillLayer.id))) {
    await selectLayerById(fillLayer.id);
    await createRevealSelectionMask();
  }

  if (config.showColorPicker) {
    await showSolidColorPicker(color);
  }

  return fillLayer;
}

async function showSolidColorPicker(color) {
  // Fill Layer 생성 대화상자와 Color Picker는 별개다. 먼저 레이어를 만든 뒤
  // 현재 Solid Color 값을 편집하면 CircleBeforeColor처럼 Color Picker만 열린다.
  const result = await action.batchPlay([{
    _obj: "set",
    _target: [{ _ref: "contentLayer", _enum: "ordinal", _value: "targetEnum" }],
    to: {
      _obj: "solidColorLayer",
      color: {
        _obj: "RGBColor",
        red: color.red,
        grain: color.green,
        blue: color.blue
      }
    },
    _options: { dialogOptions: "display" }
  }], {});

  throwOnBatchPlayError(result, "Could not open the Solid Color picker.");
}

async function layerHasUserMask(layerId) {
  const result = await action.batchPlay([{
    _obj: "get",
    _target: [
      { _property: "hasUserMask" },
      { _ref: "layer", _id: layerId }
    ],
    _options: { dialogOptions: "dontDisplay" }
  }], {});

  throwOnBatchPlayError(result, "Could not inspect the SUBJECT layer mask.");
  return Boolean(result && result[0] && result[0].hasUserMask);
}

async function selectLayerById(layerId) {
  const result = await action.batchPlay([{
    _obj: "select",
    _target: [{ _ref: "layer", _id: layerId }],
    makeVisible: false,
    layerID: [layerId],
    _options: { dialogOptions: "dontDisplay" }
  }], {});

  throwOnBatchPlayError(result, "Could not select a Photoshop layer.");
}

async function createRevealSelectionMask() {
  // UXP DOM에는 layer mask 생성 메서드가 없으므로 이 단계만 batchPlay를 사용한다.
  const result = await action.batchPlay([{
    _obj: "make",
    new: { _class: "channel" },
    at: { _ref: "channel", _enum: "channel", _value: "mask" },
    using: { _enum: "userMaskEnabled", _value: "revealSelection" },
    _options: { dialogOptions: "dontDisplay" }
  }], {});

  throwOnBatchPlayError(result, "Could not create the LOOSE BACKGROUND layer mask.");
}

function findLayerByName(layers, wantedName, excludedId) {
  const normalized = wantedName.toUpperCase();

  for (const layer of layers) {
    if (layer.id !== excludedId && layer.name.toUpperCase() === normalized) {
      return layer;
    }

    if (layer.layers && layer.layers.length > 0) {
      const nested = findLayerByName(layer.layers, wantedName, excludedId);
      if (nested) return nested;
    }
  }

  return null;
}

function ensureNoExistingResult(doc, subject) {
  const conflicts = [SUBJECT_LAYER_NAME, LOOSE_LAYER_NAME, LEGACY_LOOSE_LAYER_NAME];
  for (const name of conflicts) {
    const existing = findLayerByName(doc.layers, name, subject.id);
    if (existing) {
      throw new Error(`A "${name}" layer already exists. Undo or remove the previous result first.`);
    }
  }

  if (subject.parent) throw new Error("Move the selected cutout layer outside its group, then run the script again.");
}

function deleteLayersByName(layers, wantedName, protectedIds) {
  const normalized = wantedName.toUpperCase();
  const targets = [];

  function containsProtectedLayer(layer) {
    if (protectedIds.has(layer.id)) return true;
    if (!layer.layers || layer.layers.length === 0) return false;
    for (const child of layer.layers) {
      if (containsProtectedLayer(child)) return true;
    }
    return false;
  }

  function collect(collection) {
    for (const layer of collection) {
      if (layer.name.toUpperCase() === normalized && !containsProtectedLayer(layer)) {
        targets.push(layer);
        continue;
      }
      if (layer.layers && layer.layers.length > 0) collect(layer.layers);
    }
  }

  collect(layers);
  for (const layer of targets) layer.delete();
  return targets.length;
}

function ratioToPixels(ratio, basisPx) {
  return Math.max(0, Math.round(ratio * basisPx));
}

function formatCanvasResize(canvasResize) {
  if (!canvasResize || !canvasResize.resized) return "Canvas size unchanged";
  return `Canvas ${canvasResize.originalWidth}x${canvasResize.originalHeight} -> ` +
    `${canvasResize.newWidth}x${canvasResize.newHeight}px`;
}

function createUnchangedCanvasResize(doc) {
  const width = Math.ceil(Number(doc.width));
  const height = Math.ceil(Number(doc.height));
  return {
    resized: false,
    growX: 0,
    growY: 0,
    originalWidth: width,
    originalHeight: height,
    newWidth: width,
    newHeight: height
  };
}

function calculateCanvasResize(doc, bounds, padding) {
  const originalWidth = Math.ceil(Number(doc.width));
  const originalHeight = Math.ceil(Number(doc.height));
  const hasPadding = Object.values(padding).some((value) => Number(value) > 0);
  const safetyPx = hasPadding ? 2 : 0;
  const leftOverflow = Math.max(0, Math.ceil(Number(padding.left) + safetyPx - bounds.left));
  const rightOverflow = Math.max(
    0,
    Math.ceil(bounds.right + Number(padding.right) + safetyPx - originalWidth)
  );
  const topOverflow = Math.max(0, Math.ceil(Number(padding.top) + safetyPx - bounds.top));
  const bottomOverflow = Math.max(
    0,
    Math.ceil(bounds.bottom + Number(padding.bottom) + safetyPx - originalHeight)
  );
  const growX = Math.max(leftOverflow, rightOverflow);
  const growY = Math.max(topOverflow, bottomOverflow);

  return {
    resized: growX > 0 || growY > 0,
    growX,
    growY,
    originalWidth,
    originalHeight,
    newWidth: originalWidth + growX * 2,
    newHeight: originalHeight + growY * 2
  };
}

async function ensureCanvasFitsLooseBackground(doc, bounds, padding) {
  const resize = calculateCanvasResize(doc, bounds, padding);
  if (!resize.resized) return resize;

  await doc.resizeCanvas(
    resize.newWidth,
    resize.newHeight,
    constants.AnchorPosition.MIDDLECENTER
  );
  return resize;
}

async function expandSelectionBy(doc, pixels) {
  let remaining = Math.max(0, Math.round(pixels));
  while (remaining > 0) {
    const step = Math.min(500, remaining);
    await doc.selection.expand(step, true);
    remaining -= step;
  }
}

async function contractSelectionBy(doc, pixels) {
  let remaining = Math.max(0, Math.round(pixels));
  while (remaining > 0) {
    const step = Math.min(500, remaining);
    await doc.selection.contract(step, true);
    remaining -= step;
  }
}

function validateConfig(config) {
  const ratioKeys = [
    "topMarginRatio",
    "bottomMarginRatio",
    "closeRadiusRatio",
    "smoothRadiusRatio",
    "finalSmoothRadiusRatio"
  ];

  for (const key of ratioKeys) {
    const value = config[key];
    if (!Number.isFinite(value) || value < 0 || value > 0.5) {
      throw new Error(`${key} must be a ratio between 0 and 0.5.`);
    }
  }

  if (!Number.isFinite(config.pathTolerance) || config.pathTolerance < 0.5 || config.pathTolerance > 10) {
    throw new Error("pathTolerance must be between 0.5 and 10.");
  }

  if (!Array.isArray(config.sideProfile) || config.sideProfile.length === 0) {
    throw new Error("sideProfile must contain at least one vertical band.");
  }

  for (const band of config.sideProfile) {
    if (
      !Number.isFinite(band.from) ||
      !Number.isFinite(band.to) ||
      band.from < 0 ||
      band.to > 1 ||
      band.from >= band.to
    ) {
      throw new Error("Each sideProfile band must satisfy 0 <= from < to <= 1.");
    }

    if (!Number.isFinite(band.marginRatio) || band.marginRatio < 0 || band.marginRatio > 0.5) {
      throw new Error("Each sideProfile marginRatio must be between 0 and 0.5.");
    }
  }

  const hand = config.handProfile;
  if (
    !hand ||
    !Number.isFinite(hand.from) ||
    !Number.isFinite(hand.to) ||
    hand.from < 0 ||
    hand.to > 1 ||
    hand.from >= hand.to ||
    !Number.isFinite(hand.outerWidthRatio) ||
    hand.outerWidthRatio <= 0 ||
    hand.outerWidthRatio > 0.5 ||
    !Number.isFinite(hand.marginRatio) ||
    hand.marginRatio < 0 ||
    hand.marginRatio > 0.5
  ) {
    throw new Error("handProfile must define valid from/to, outerWidthRatio, and marginRatio values.");
  }

  if (typeof config.showColorPicker !== "boolean") {
    throw new Error("showColorPicker must be true or false.");
  }

  if (typeof config.autoResizeCanvas !== "boolean") {
    throw new Error("autoResizeCanvas must be true or false.");
  }

  for (const channel of ["red", "green", "blue"]) {
    const value = config.defaultColor && config.defaultColor[channel];
    if (!Number.isFinite(value) || value < 0 || value > 255) {
      throw new Error(`defaultColor.${channel} must be between 0 and 255.`);
    }
  }
}

function copyBounds(bounds) {
  if (!bounds) return null;
  return {
    top: Number(bounds.top),
    left: Number(bounds.left),
    bottom: Number(bounds.bottom),
    right: Number(bounds.right)
  };
}

function assertSelection(doc, message) {
  if (!doc.selection.bounds) throw new Error(message);
}

function throwOnBatchPlayError(result, fallbackMessage) {
  const first = result && result[0];
  if (first && first._obj === "error") {
    throw new Error(first.message || fallbackMessage);
  }
}

async function runStage(label, operation) {
  try {
    return await operation();
  } catch (error) {
    throw new Error(`${label}: ${error.message || String(error)}`);
  }
}

await main();
