{
  "id": "everstory_loose_background",
  "name": "Everstory Loose Background",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.5.0"
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "looseBackground",
      "minimumSize": { "width": 260, "height": 280 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 430 },
      "preferredFloatingSize": { "width": 340, "height": 460 },
      "label": { "default": "Everstory Loose Background" }
    }
  ]
}
